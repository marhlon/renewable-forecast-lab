# Política e exceções: docs/VERSIONAMENTO.md
# Estas regras não retiram arquivos que já estão no índice do Git.

# Ambientes Python e dependências instaladas
.venv/
.venvs/
venv/
venvs/
.conda/
.tox/
.nox/

# Caches, bytecode e cobertura
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Notebooks: manter os .py e .ipynb; ignorar somente checkpoints do editor
.ipynb_checkpoints/

# Configuração local e credenciais; exemplos sanitizados continuam visíveis
.env
.env.*
!.env.example
!.env.sample
!.env.template
/secrets/
/.aws/credentials
.vscode/
.idea/

# Temporários do sistema e editor
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.bak
*.swp
*~

# Backups locais: manter revisões e evidências selecionadas em docs/
/backups/
/notebooks/*_antes_*.py
/tools/*_antes_*.ps1

# Dados brutos e intermediários regeneráveis do P1
# Manter referências pequenas em data/reference/ e os recortes do P2.
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/README.md
!/data/raw/*.metadata.json
!/data/raw/DicionarioDados_GeracaoPorUsina.json
/data/interim/
/data/processed/
/data/external/runtime/

# Pesos e modelos locais; especificações/identidades ficam em docs/ e config/
/models/*
!/models/.gitkeep
!/models/README.md
/satellite-anomaly-monitor/models/

# MLflow e bases de acompanhamento locais
mlruns/
mlartifacts/
/mlflow.db
/mlflow.db-*
/mlflow_tracking*.db
/mlflow_tracking*.db-*

# Build e pacotes de entrega na raiz
/build/
/*.zip
/*.7z
/satellite-anomaly-monitor/*.zip

# dist/ é misto: manter dist/databricks e contratos de container.
# Ignorar binários, dependências e cópias exportadas do código-fonte.
/dist/**/wheelhouse/
/dist/**/_internal/
/dist/event_service/**/source/
/dist/**/*.exe
/dist/**/*.dll
/dist/**/*.pyd
/dist/**/*.whl
/dist/**/*.joblib
/dist/**/*.pkl
/dist/**/*.pt
/dist/**/*.pth
/dist/**/*.safetensors

# Resultados: manter pareceres, JSON, CSV/CSV.GZ, HTML e NPZ de auditoria.
# Não ignorar reports/ inteiro nem extensões de dados globalmente.
/reports/setup/
/reports/**/*.log
/reports/**/*.parquet
/reports/**/*.joblib
/reports/**/*.pkl
/reports/**/*.pt
/reports/**/*.pth
/reports/**/*.safetensors
/reports/**/*.skops
/reports/**/*.sqlite
/reports/**/*.sqlite-shm
/reports/**/*.sqlite-wal
/reports/**/checkpoints/
# Copias de ensaio do CI: conservar manifestos/logs selecionados, nao duplicar fonte.
/reports/fechamento_m00_m09/bloco3_engenharia/M06-02/copia_isolada*/
/satellite-anomaly-monitor/reports/**/*.log
/satellite-anomaly-monitor/reports/**/*.parquet
/satellite-anomaly-monitor/reports/**/*.joblib
/satellite-anomaly-monitor/reports/**/*.pkl
/satellite-anomaly-monitor/reports/**/*.pt
/satellite-anomaly-monitor/reports/**/*.pth
/satellite-anomaly-monitor/reports/**/*.safetensors
/satellite-anomaly-monitor/reports/**/checkpoints/
